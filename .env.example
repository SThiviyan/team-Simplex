# Copy this to `.env` and fill in any local-dev overrides your team adds.
# By default the template needs no env vars — `make dev` works out of the box.
#
# Production secrets (LLM keys, DB URLs the deploy injects) go in `secrets.yaml`,
# NOT here. `.env` is for local-dev only.

# --- Frontend --------------------------------------------------------------
# Vite proxies `/api/*` to the backend. Defaults to `http://backend:8080`
# (the compose service name) which is correct for `make dev`. Override only
# if you run the frontend OUTSIDE compose (e.g. `cd frontend && npm run dev`
# against a backend you're running directly on your host):
# VITE_PROXY_TARGET=http://localhost:8080

# --- Backend ---------------------------------------------------------------
# In `make dev`, compose passes values from this repo-root `.env` into the
# backend container. If you run the backend directly from `backend/`, either
# export env vars in your shell or create `backend/.env`.

# Anthropic key for the registry-lookup pipeline (POST /api/pipeline/run).
# ANTHROPIC_API_KEY=sk-ant-...

# Set to true to run the pipeline without any API calls (deterministic stubs).
# PIPELINE_MOCK=false
